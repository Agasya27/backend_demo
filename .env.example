# LLM Configuration
# Choose one: openai, anthropic, gemini, openrouter
LLM_PROVIDER=openrouter

# API Key for your chosen provider
# Get your key from the respective provider:
# - OpenRouter: https://openrouter.ai/keys (Recommended - has free tier)
# - OpenAI: https://platform.openai.com/api-keys
# - Anthropic: https://console.anthropic.com/
# - Gemini: https://makersuite.google.com/app/apikey
LLM_API_KEY=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

# OpenRouter Model (only used when LLM_PROVIDER=openrouter)
# Default: meta-llama/llama-3.1-8b-instruct:free (free tier)
# Other options: meta-llama/llama-3.1-70b-instruct, openai/gpt-3.5-turbo, etc.
# See https://openrouter.ai/models for all available models
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
