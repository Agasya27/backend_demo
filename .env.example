# LLM Configuration
# Choose one: openai, anthropic, gemini, openrouter
LLM_PROVIDER=openrouter

# API Key for your chosen provider
# Get your key from the respective provider:
# - OpenRouter: https://openrouter.ai/keys (Recommended - has free tier)
# - OpenAI: https://platform.openai.com/api-keys
# - Anthropic: https://console.anthropic.com/
# - Gemini: https://makersuite.google.com/app/apikey
LLM_API_KEY=your-api-key-here

# OpenRouter Model (only used when LLM_PROVIDER=openrouter)
# Recommended for production: openai/gpt-4o-mini (~$0.15 per 1M tokens, high quality)
# Alternative: openai/chatgpt-4o-latest (actual ChatGPT, ~$5 per 1M tokens)
# Free tier for testing: liquid/lfm-2.5-1.2b-instruct:free
# See https://openrouter.ai/models for all available models
OPENROUTER_MODEL=openai/gpt-4o-mini
