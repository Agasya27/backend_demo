# Django Configuration
SECRET_KEY=django-insecure-dev-key-change-in-production
DEBUG=True

# Database Configuration
# For local development, leave DATABASE_URL commented out to use SQLite
# For production (Render), this will be set automatically by the platform
# DATABASE_URL=postgresql://user:password@host:port/database

# Frontend URL (for CORS)
# For production, set this to your Vercel deployment URL
# FRONTEND_URL=https://your-app.vercel.app

# LLM Configuration
# Choose one: openai, anthropic, gemini, openrouter
LLM_PROVIDER=openrouter

# API Key for your chosen provider
# Get your key from the respective provider:
# - OpenRouter: https://openrouter.ai/keys (Recommended - has free tier)
# - OpenAI: https://platform.openai.com/api-keys
# - Anthropic: https://console.anthropic.com/
# - Gemini: https://makersuite.google.com/app/apikey
LLM_API_KEY=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

# Individual API Keys (optional - set only if using that specific provider)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Model Configuration
# OpenRouter Model (only used when LLM_PROVIDER=openrouter)
# Recommended for production: openai/gpt-4o-mini (~$0.15 per 1M tokens, high quality)
# Alternative: openai/chatgpt-4o-latest (actual ChatGPT, ~$5 per 1M tokens)
# Free tier for testing: liquid/lfm-2.5-1.2b-instruct:free
# See https://openrouter.ai/models for all available models
OPENROUTER_MODEL=openai/gpt-4o-mini

OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_MODEL=gemini-1.5-flash

